      "name": "room",
      "description": "Declare room state in plain words (\"Mom's here\", \"I'm alone\"). Updates presence belief with asymmetric trust: declarations can add listeners freely, but 'alone' only loosens low-sensitivity items. Never confirms or denies secrets.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "declaration": {
            "type": "string",
            "minLength": 1,
