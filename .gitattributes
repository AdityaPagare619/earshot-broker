# Normalize line endings on checkout/commit so Windows clones get CRLF where
# the shell wants it and the repo stays LF-canonical for Python sources.
* text=auto

# Python sources: always LF in the repo; Python on Windows accepts LF fine.
*.py text eol=lf

# Text formats we generate/parse: LF canonical.
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.zip binary
*.whl binary
